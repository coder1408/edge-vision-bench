# syntax=docker/dockerfile:1.7

FROM python:3.11-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

WORKDIR /build
COPY pyproject.toml ./
COPY src ./src

RUN pip install --upgrade pip wheel setuptools \
    && pip install --index-url https://download.pytorch.org/whl/cpu torch torchvision \
    && pip install ".[cpu]"


FROM python:3.11-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH" \
    EVB_CONFIG="/app/configs/yolox_s_sportsmot.yaml" \
    EVB_RUNTIME="onnxruntime" \
    EVB_PRECISION="fp32" \
    EVB_DEVICE="cpu" \
    EVB_RESULTS_DIR="/app/results"

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 10001 evb \
    && useradd --uid 10001 --gid evb --shell /usr/sbin/nologin --create-home evb

COPY --from=builder /opt/venv /opt/venv

WORKDIR /app
COPY configs ./configs

RUN mkdir -p /app/models/artifacts /app/models/weights /app/results \
    && chown -R evb:evb /app

USER evb

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/healthz', timeout=3)"]

CMD ["uvicorn", "edge_vision_bench.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
